# Sarvam AI — get from https://dashboard.sarvam.ai
SARVAM_API_KEY=your_sarvam_api_key_here
# Chat models (sarvam-m was retired). Defaults: actor on the real-time model, everything else on 105b.
# SARVAM_ACTOR_MODEL=sarvam-105b-conversations
# SARVAM_LLM_MODEL=sarvam-105b

# Supabase — PatchUp project (ap-south-1)
# URL is pre-filled. Get the service role key from:
# https://supabase.com/dashboard/project/rbpuqakesdymfpzhakok/settings/api
# Leave SUPABASE_SERVICE_KEY blank to use in-memory storage (works fine for testing)
SUPABASE_URL=https://rbpuqakesdymfpzhakok.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key_here

# ElevenLabs — primary voice provider when set (Eleven v3 TTS with emotion tags, Scribe STT).
# Every ElevenLabs failure falls back to Sarvam for that call. Leave blank to use Sarvam only.
ELEVENLABS_API_KEY=
# Force a provider regardless of keys: elevenlabs | sarvam (default: elevenlabs if the key is set)
# TTS_PROVIDER=
# STT_PROVIDER=
# ELEVENLABS_TTS_MODEL=eleven_v3            # eleven_v3_conversational is faster; eleven_multilingual_v2 only speaks en/hi/ta of our languages
# ELEVENLABS_STT_MODEL=scribe_v2
# ELEVENLABS_VOICE_IDS_FEMALE=id1,id2       # otherwise picked from your account's voices by gender (Indian accents first)
# ELEVENLABS_VOICE_IDS_MALE=id1,id2
# ELEVENLABS_BASE_URL=https://api.elevenlabs.io   # e.g. https://api.in.residency.elevenlabs.io on an India-residency plan

# TypeSafe Jev — judges each turn (counterpart movement + coach scores) and screens
# custom scenarios. Get a key at https://console.typesafe.ai. Leave blank and the
# Sarvam-M actor self-reports movement and the coach self-scores instead.
TYPESAFE_API_KEY=

# Browser origins allowed to call the API, comma-separated. Defaults to localhost:3000.
# In production set this to your frontend URL, e.g. https://patchup.vercel.app
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Optional regex for origins that change per deployment, e.g. Vercel previews:
# ALLOWED_ORIGIN_REGEX=^https://patchup(-[a-z0-9-]+)?-<team-slug>\.vercel\.app$
ALLOWED_ORIGIN_REGEX=
