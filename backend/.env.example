# Sarvam AI — get from https://dashboard.sarvam.ai
SARVAM_API_KEY=your_sarvam_api_key_here

# Supabase — PatchUp project (ap-south-1)
# URL is pre-filled. Get the service role key from:
# https://supabase.com/dashboard/project/rbpuqakesdymfpzhakok/settings/api
# Leave SUPABASE_SERVICE_KEY blank to use in-memory storage (works fine for testing)
SUPABASE_URL=https://rbpuqakesdymfpzhakok.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key_here

# TypeSafe Jev — judges each turn (counterpart movement + coach scores) and screens
# custom scenarios. Get a key at https://console.typesafe.ai. Leave blank and the
# Sarvam-M actor self-reports movement and the coach self-scores instead.
TYPESAFE_API_KEY=

# Browser origins allowed to call the API, comma-separated. Defaults to localhost:3000.
# In production set this to your frontend URL, e.g. https://patchup.vercel.app
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Optional regex for origins that change per deployment, e.g. Vercel previews:
# ALLOWED_ORIGIN_REGEX=^https://patchup(-[a-z0-9-]+)?-<team-slug>\.vercel\.app$
ALLOWED_ORIGIN_REGEX=
